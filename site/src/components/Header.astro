---
import compactRaw from '../assets/logo/wordmark-compact.svg?raw';
import markRaw from '../assets/logo/mark-small.svg?raw';
import ui from '../content/en/ui.json';
import { inlineSvg } from '../lib/svg.ts';

// The header always uses the compact cut: it renders under 480px wide (brand/logo/README.md).
const logo = inlineSvg(compactRaw, { className: 'logo-svg site-header__logo' });
const mark = inlineSvg(markRaw, { className: 'logo-svg site-header__mark' });
---
<header class="site-header">
  <div class="frame site-header__bar">
    <a class="site-header__home" href="/" aria-label={ui.homeLinkLabel}>
      <Fragment set:html={logo} />
      <Fragment set:html={mark} />
    </a>
    <nav class="site-header__nav" aria-label={ui.navLabel}>
      <ul>
        {ui.nav.map((item) => <li><a href={item.href} aria-current={Astro.url.pathname.replace(/\/$/, '').startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style is:global>
  /*
   * Logo hand-off (scene 1, structure-v1 §2.2): the wordmark docks into the header logo box, so the
   * header must stay at the top while the hero scrolls. --header-h is the bar's fixed height; the
   * hero pulls its stage up under the header by the same amount (Hero.astro).
   */
  :root { --header-h: var(--s-8); }
  /* html prefix: wins over base.css's `.site-header { position: relative }` whatever the CSS order. */
  html .site-header {
    position: sticky;
    inset-block-start: 0;
    background: var(--bg);
  }
  html .site-header__bar { block-size: var(--header-h); }
  /* While the canvas carries the wordmark: the DOM logo is hidden and the header lets the canvas
     show through. Set only by Hero.astro's script while the logo scene is live. */
  html[data-logo-handoff="flight"] .site-header { background: transparent; }
  html[data-logo-handoff="flight"] .site-header__logo { visibility: hidden; }
</style>
