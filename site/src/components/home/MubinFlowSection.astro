---
/**
 * Home §4 MubinFlow (structure-v1 §2.2 scene 6). Owned by the mubinflow scene agent.
 * Every word comes from content/en/products/mubinflow.json. No CTA and no link: the product has
 * no site and the owner has not approved one (copy deck §4; the JSON's `cta` is empty).
 *
 * Layout: headline and promise, then the drafting scene, then the three "built so far" points and
 * the status line. Without JS, with reduced motion, on the still tier or after a failure, the stage
 * is an ordinary 16:9 block with its still and every word is still in the HTML.
 *
 * Pin (desktop >= 60rem, live 3D only): the slot is 250svh tall (polish pass; was 320svh) and its 16:9 stage is sticky,
 * centred in the viewport. Progress 0..1 = slot top at 75% of the viewport -> slot bottom at the
 * viewport bottom (about 225svh of scroll; set by the script below, only >= 60rem). Progress starts
 * while the stage scrolls in, so the ring is already drawing when the stage settles (at p 0 the
 * sheet is empty: starting at "top top" left a blank viewport, checked by screenshot). The
 * runtime measures a sticky stage's visibility from its slot (motion/scroll.ts), so the scene
 * stays live for the whole pin and is freed after.
 *
 * Stage size: capped at 1168 px wide (px, not rem: the root grows to 112.5% on 2200px+ screens) so a 16:9 stage stays under the 'high' tier's 3.1 MP
 * target cap and renders at the full DPR 2 (lines stay crisp).
 */
import SceneSlot from '../SceneSlot.astro';
import p from '../../content/en/products/mubinflow.json';
---
<section class="home-mubinflow" aria-labelledby="mubinflow-title" data-section="mubinflow">
  <div class="frame mf-head">
    <h2 id="mubinflow-title" class="mf-title">{p.headline}</h2>
    <p class="mf-promise">{p.promise}</p>
  </div>

  <div class="frame mf-pin">
    <SceneSlot slot="mubinflow" scene="mubinflow" start="top 65%" end="top 5%" class="mubinflow-slot" />
  </div>

  <div class="frame mf-body">
    <ul class="mf-proof">
      {p.proof.map((item) => (
        <li class="mf-proof__item">
          <h3 class="mf-proof__title">{item.title}</h3>
          <p class="mf-proof__body">{item.body}</p>
        </li>
      ))}
    </ul>
    <p class="mf-status">
      <span class="mf-status__ring" aria-hidden="true"></span>
      <span>{p.statusLine}</span>
    </p>
  </div>
</section>

<script>
  /*
   * The pinned range applies only where the pin CSS does (>= 60rem). Narrower, the stage is an
   * ordinary block and keeps the default "top 65%" -> "top 5%" scrub (a pinned range on a short
   * slot would end before it starts). Runs before three/mount.ts reads the attributes (mount is
   * imported after load + idle). A later resize across 60rem keeps the range read at mount.
   */
  const slot = document.querySelector<HTMLElement>('.home-mubinflow [data-scene-slot="mubinflow"]');
  if (slot && window.matchMedia('(min-width: 60rem)').matches) {
    slot.dataset.sceneStart = 'top 75%';
    slot.dataset.sceneEnd = 'bottom bottom';
  }
</script>

<style>
  .home-mubinflow { padding-block: var(--s-12) var(--s-10); }

  .mf-head {
    display: grid;
    gap: var(--s-3);
    margin-block-end: var(--s-6);
  }
  .mf-title {
    max-inline-size: 10em;
    font-size: var(--t-feature);
    font-weight: var(--w-display);
    line-height: var(--lh-display);
    letter-spacing: var(--track-hero);
    text-wrap: balance;
  }
  .mf-promise {
    max-inline-size: 22em;
    font-size: var(--t-lead-lg);
    line-height: var(--leading-md);
    color: var(--fg-muted);
  }
  @media (min-width: 64rem) {
    .mf-head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
    }
  }

  /* SceneSlot is another component: reach its stage with :global, one attribute more specific than
     its own scoped .scene-stage rule so the CSS order of the bundle cannot flip the aspect ratio. */
  /* The stage: 16:9, capped so it renders at full DPR on the 'high' tier. */
  :global(.mubinflow-slot .scene-stage[data-scene-stage]) {
    aspect-ratio: 16 / 9;
    inline-size: min(100%, 1168px);
    margin-inline: auto;
  }
  /*
   * The pin. `cqi` = the frame's content width, so the stage height (and the sticky offset that
   * centres it) is known in CSS: height = width * 9/16, top = (100svh - height) / 2. The width is
   * also capped by the viewport height so the whole stage always fits on screen.
   */
  .mf-pin { container-type: inline-size; }
  @media (min-width: 60rem) {
    :global(html.js:not([data-tier="still"])) .home-mubinflow :global(.mubinflow-slot:not([data-scene-state="failed"])) {
      --mf-stage-w: min(100cqi, 1168px, (100svh - 2 * var(--s-4)) * 16 / 9);
      block-size: 250svh;
    }
    :global(html.js:not([data-tier="still"])) .home-mubinflow :global(.mubinflow-slot:not([data-scene-state="failed"]) .scene-stage[data-scene-stage]) {
      position: sticky;
      inset-block-start: calc((100svh - var(--mf-stage-w) * 9 / 16) / 2);
      inline-size: var(--mf-stage-w);
    }
  }

  .mf-body { margin-block-start: var(--s-8); }
  .mf-proof {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 60rem) {
    .mf-proof { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-6); }
  }
  .mf-proof__item {
    padding-block-start: var(--s-2);
    border-block-start: var(--hairline) solid var(--rule);
  }
  .mf-proof__title {
    margin: 0 0 var(--s-1);
    font-size: var(--t-base);
    font-weight: 600;
    line-height: 1.3;
  }
  .mf-proof__body {
    max-inline-size: var(--measure);
    font-size: var(--t-sm);
    color: var(--fg-muted);
  }

  /* Status: an OPEN Rhodamine ring (outline = in development; a filled dot means live, scene 3). */
  .mf-status {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    margin-block-start: var(--s-6);
    font-size: var(--t-sm);
    color: var(--fg-muted);
  }
  .mf-status__ring {
    flex: none;
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border: 1.5px solid var(--rhodamine);
    border-radius: 50%;
  }
</style>
