---
/**
 * Home scene 3, "The line" (structure-v1 §2.2): the product index from copy deck §2, beside the
 * rail scene's docking stations.
 *
 * Two layouts, one markup:
 * - Static (no JS, reduced motion, the 'still' tier, or a failed scene): a plain list. Every word
 *   is in the HTML from first paint.
 * - Staged (JS and a 3D tier): the section is tall, the stage is sticky and full-bleed, and each
 *   label is anchored beside its station. The anchors are computed HERE at build time from the
 *   scene's own layout maths (three-free), so the canvas and the DOM cannot drift apart. Each
 *   label reveals when its product touches its pad (layout.ts contactAt, the same moment its
 *   status light comes on).
 *
 * Handover from scene 2: Statements.astro ends with a quiet beat (--home-datum-beat) holding the
 * DOM datum line at the viewport centre; this section overlaps it by the same amount, so when this
 * section reaches the top the canvas datum (progress 0) lies exactly under the DOM line. The beat
 * is opaque and covers the canvas datum until then (no second line riding in with the stage).
 */
import home from '../content/en/home.json';
import SceneSlot from './SceneSlot.astro';
import { RAIL_PARAMS } from '../three/scenes/rail/params.ts';
import { contactAt, labelAnchors } from '../three/scenes/rail/layout.ts';

const anchors = new Map(labelAnchors(home.productIndex.items, RAIL_PARAMS).map((a) => [a.slug, a]));
const items = home.productIndex.items.map((p, i) => {
  const a = anchors.get(p.slug);
  // --t: the label reveals when its product touches the pad, together with its status light.
  const style = a ? `--ax:${a.inlineFraction.toFixed(4)};--ak:${a.k.toFixed(4)};--t:${contactAt(i).toFixed(4)}` : '';
  return { ...p, style };
});
---
<section class="products" id={home.productIndex.id}>
  <!-- start "top -5%": the canvas datum is under the DOM line from "top top"; the DOM line and the
       Statements beat fade out over the next 3% (Statements.astro), then the rail starts. -->
  <SceneSlot slot="rail" scene="rail" start="top -5%" end="bottom bottom" class="products__slot">
    <ul class="products__list">
      {items.map((p) => (
        <li class="product" data-status={p.status} data-product={p.slug} style={p.style}>
          <span class="product__status" aria-hidden="true"></span>
          <h2 class="product__name">{p.name}</h2>
          <p class="product__line">{p.line}</p>
          {p.href
            ? <a class="product__label" href={p.href} rel="noopener">{p.label}</a>
            : <span class="product__label">{p.label}</span>}
        </li>
      ))}
    </ul>
  </SceneSlot>
</section>

<script>
  /*
   * Mirrors the scene's progress into --rail-p for the label reveals. Same trigger and range as
   * motion/scroll.ts uses for the slot, so labels and docks agree. No three.js on this path.
   * ?scene=rail&p=<n> freezes it, like the scene itself (debug links and screenshots).
   */
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { currentFlags } from '../lib/flags.ts';
  import { createLogger } from '../lib/log.ts';

  const log = createLogger('ui:products');
  const slot = document.querySelector<HTMLElement>('[data-scene-slot="rail"]');
  if (slot) {
    const set = (p: number): void => slot.style.setProperty('--rail-p', p.toFixed(4));
    const flags = currentFlags();
    if (flags.scene === 'rail' && flags.progress !== null) {
      set(flags.progress);
      slot.dataset.railFrozen = '';
    } else if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      gsap.registerPlugin(ScrollTrigger);
      // onUpdate fires only when progress changes, so also write it on refresh (load, resize):
      // before the range starts the labels must read p = 0, not the CSS fallback.
      const sync = (self: ScrollTrigger): void => {
        if (slot.dataset.railFrozen === undefined) set(self.progress);
      };
      const trigger = ScrollTrigger.create({
        trigger: slot,
        start: slot.dataset.sceneStart ?? 'top top',
        end: slot.dataset.sceneEnd ?? 'bottom bottom',
        onUpdate: sync,
        onRefresh: sync,
      });
      sync(trigger);
      log.debug('label reveals bound to scroll');
    }
  }
</script>

<style>
  /* ---------- Static layout: a list (no JS, reduced motion, 'still' tier, failed scene) ---------- */
  .products__list { margin: 0; padding: 0; list-style: none; }
  .product {
    display: grid;
    grid-template-columns: var(--s-2) minmax(0, 1fr);
    column-gap: var(--s-2);
    row-gap: var(--s-1);
    padding-block: var(--s-4);
    border-block-start: var(--hairline) solid var(--rule);
  }
  .product__status {
    inline-size: 0.5rem; block-size: 0.5rem;
    margin-block-start: 0.55em;
    border-radius: 50%;
    border: var(--hairline) solid var(--fg-muted);
  }
  /* Rhodamine dot = live; outline only = in development (structure-v1 scene 3). */
  .product[data-status="live"] .product__status { background: var(--signal); border-color: var(--signal); }
  .product__name { font-size: var(--t-md); font-weight: 600; letter-spacing: var(--track-display); }
  .product__line, .product__label { grid-column: 2; }
  .product__line { color: var(--fg-muted); max-inline-size: var(--measure); }
  .product__label { font-size: var(--t-sm); justify-self: start; }
  :global(.products__slot) { padding-inline: var(--gutter); max-inline-size: var(--page-max); margin-inline: auto; }
  :global(.products__slot .scene-stage) { aspect-ratio: 21 / 9; }
  @media (min-width: 60rem) {
    .product { grid-template-columns: var(--s-2) minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr); align-items: baseline; }
    .product__line, .product__label { grid-column: auto; }
    .product__label { justify-self: end; }
  }

  /* ---------- Staged layout: JS + a 3D tier, while the scene has not failed ---------- */
  /* Tall pinned section, overlapping the quiet end beat of Statements (the datum handover). A failed scene (error, context loss) drops back to the static list, with no
     empty viewports left behind. */
  :global(html.js:not([data-tier="still"]):not([data-tier="none"])) .products:not(:has(.products__slot[data-scene-state="failed"])) {
    block-size: var(--home-rail-length);
    margin-block-start: calc(-1 * var(--home-datum-beat));
  }
  :global(html.js:not([data-tier="still"]):not([data-tier="none"]) .products__slot:not([data-scene-state="failed"])) {
    block-size: 100%;
    max-inline-size: none;
    padding-inline: 0;
    /* One grid cell as tall as the section: the label layer and the stage share it, each sticky
       for the whole range and released together at the section's end. (A negative margin to
       stack them shrank the list's margin box, so it stayed stuck one viewport too long and
       covered the QuotesDone intro.) */
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
  }
  :global(html.js:not([data-tier="still"]):not([data-tier="none"]) .products__slot:not([data-scene-state="failed"]) .scene-stage) {
    grid-area: 1 / 1;
    align-self: start;
    position: sticky;
    inset-block-start: 0;
    block-size: 100svh;
    aspect-ratio: auto;
  }
  :global(html.js:not([data-tier="still"]):not([data-tier="none"]) .products__slot:not([data-scene-state="failed"]) .scene-fallback) { display: none; }
  :global(html.js:not([data-tier="still"]):not([data-tier="none"]) .products__slot:not([data-scene-state="failed"])) .products__list {
    grid-area: 1 / 1;
    align-self: start;
    position: sticky;
    inset-block-start: 0;
    z-index: 1;
    block-size: 100svh;
    container-type: size;
    pointer-events: none;
  }
  :global(html.js:not([data-tier="still"]):not([data-tier="none"]) .products__slot:not([data-scene-state="failed"])) .product {
    position: absolute;
    /* Anchors from the scene's layout maths: x is a fraction of the width; y is a multiple of half
       the WIDTH from the centre (fixed horizontal field of view; see rail/layout.ts). */
    inset-inline-start: calc(var(--ax) * 100cqw - var(--s-1));
    inset-block-start: calc(50cqh - var(--ak) * 50cqw + var(--s-4));
    inline-size: min(17rem, 24cqw);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--s-1);
    padding-block: 0;
    padding-inline-start: var(--s-1);
    border-block-start: 0;
    border-inline-start: var(--hairline) solid var(--rule);
    pointer-events: auto;
  }
  :global(html.js:not([data-tier="still"]):not([data-tier="none"]) .products__slot:not([data-scene-state="failed"])) .product__status {
    display: none; /* the station's own status light carries it in the staged layout */
  }
  :global(html.js:not([data-tier="still"]):not([data-tier="none"]) .products__slot:not([data-scene-state="failed"])) .product > * {
    grid-column: 1;
  }
  :global(html.js:not([data-tier="still"]):not([data-tier="none"]) .products__slot:not([data-scene-state="failed"])) .product__label {
    justify-self: start;
  }
  :global(html.js:not([data-tier="still"]):not([data-tier="none"]) .products__slot:not([data-scene-state="failed"])) .product__line {
    font-size: var(--t-sm);
  }
  /* Staged: the name is the label's headline, set in the display width beside its station. */
  :global(html.js:not([data-tier="still"]):not([data-tier="none"]) .products__slot:not([data-scene-state="failed"])) .product__name {
    font-family: var(--font-display);
    font-stretch: var(--wdth-display);
    font-size: var(--t-lg);
    font-weight: var(--w-display);
    line-height: var(--lh-display);
  }
  /* Reveal each label once its product has docked. Only while the scene is live: in every other
     state the words stay visible. Opacity and a short rise only (transform + opacity). */
  :global(.products__slot[data-scene-state="live"]) .product {
    --rv: clamp(0, calc((var(--rail-p, 1) - var(--t, 0)) * 28), 1);
    opacity: var(--rv);
    transform: translateY(calc((1 - var(--rv)) * var(--s-1)));
  }
</style>
