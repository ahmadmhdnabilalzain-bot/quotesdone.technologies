---
import home from '../content/en/home.json';
import SceneSlot from './SceneSlot.astro';
---
<section class="products" id={home.productIndex.id}>
  <SceneSlot slot="rail" scene="rail" start="top top" end="bottom bottom" class="products__slot">
    <ul class="products__list">
      {home.productIndex.items.map((p) => (
        <li class="product" data-status={p.status}>
          <h2 class="product__name">{p.name}</h2>
          <p class="product__line">{p.line}</p>
        </li>
      ))}
    </ul>
  </SceneSlot>
</section>

<style>
  .products { position: relative; }
  :global(html.js:not([data-tier="still"])) .products { block-size: 400svh; }
  :global(html.js:not([data-tier="still"]) .products__slot) { block-size: 100%; }
  :global(html.js:not([data-tier="still"]) .products__slot .scene-stage) {
    position: sticky; inset-block-start: 0; block-size: 100svh; aspect-ratio: auto;
  }
</style>
