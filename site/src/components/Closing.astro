---
/**
 * Home scene 8, Close. Owned by the company/close agent.
 * The rail ends in the Q end cap (3D, inline-end of the frame); the closing line, the products
 * button and the contact call sit beside it (inline-start). Copy: home.json `closing`
 * (copy deck section 2) and company.json `home.contact` (copy deck sections 5 and 6).
 * Only confirmed facts are shown: the company email and phone are [OWNER TO CONFIRM] in the
 * deck and are not in the content files at all.
 * Progress runs from the stage entering to the bottom of the page ("max"), so the canvas has
 * faded to Carbon by the time the footer is fully in view.
 */
import SceneSlot from './SceneSlot.astro';
import home from '../content/en/home.json';
import company from '../content/en/company.json';
const contact = company.home.contact;
---
<section class="closing" aria-labelledby="closing-title" data-section="close">
  <SceneSlot slot="close" scene="close" start="top bottom" end="max" class="closing__slot">
    <div class="frame closing__over">
      <div class="closing__copy">
        <h2 id="closing-title" class="closing__title" data-reveal="line">{home.closing.headline}</h2>
        <a class="closing__cta" href={home.closing.cta.href}>{home.closing.cta.label}</a>

        <div class="closing__contact">
          <h3 class="closing__contact-title"><a href={contact.href}>{contact.headline}</a></h3>
          <p class="closing__routing">
            {contact.routingLead}{' '}
            {contact.routing.map((r) => (
              <><a href={r.href} rel={r.href.startsWith('http') ? 'noopener' : undefined}>{r.label}</a>{r.after}</>
            ))}
          </p>
          <p class="closing__identity">
            {contact.identity.map((line) => <span>{line}</span>)}
          </p>
        </div>
      </div>
    </div>
  </SceneSlot>
</section>

<style>
  .closing { position: relative; padding-block-start: var(--s-16); }

  /* Narrow screens: words first, then the end cap below them (the Q is centred in portrait and
     would sit behind the text). Wide screens: one grid cell, words beside the Q. */
  .closing :global(.closing__slot) { display: grid; }
  .closing :global(.closing__slot .scene-stage) {
    aspect-ratio: auto;
    block-size: clamp(24rem, 60svh, 40rem);
  }
  @media (min-width: 60rem) {
    .closing :global(.closing__slot > *) { grid-area: 1 / 1; }
    .closing :global(.closing__slot .scene-stage) { block-size: clamp(32rem, 96svh, 68rem); }
  }
  /* Still: the datum hairline at the rail's height, ending where the end cap would be. */
  .closing :global(.closing__slot .scene-still) { justify-items: start; }
  .closing :global(.closing__slot .scene-still__plate) {
    inline-size: 72%;
    aspect-ratio: auto;
    block-size: var(--hairline);
    transform: none;
    border: 0;
    background: color-mix(in srgb, var(--signal) 55%, transparent);
  }
  @media (min-width: 60rem) {
    /* about where the rail sits in the live frame */
    .closing :global(.closing__slot .scene-still__plate) { translate: 0 30svh; }
  }
  .closing :global(.closing__slot .scene-fallback) {
    grid-row: 3;
    padding-inline: var(--gutter);
  }

  .closing__over {
    position: relative;
    z-index: 1;
    align-self: center;
    pointer-events: none;
  }
  .closing__copy {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    max-inline-size: 30rem;
    pointer-events: auto;
  }
  @media (min-width: 60rem) {
    /* Inline-start half; the end cap owns the other side of the frame. */
    .closing__copy { max-inline-size: min(30rem, 42%); }
  }
  .closing__title {
    font-size: var(--t-xl);
    line-height: var(--lh-tight);
    letter-spacing: var(--track-display);
    font-weight: 600;
  }
  .closing__cta {
    display: inline-block;
    padding: var(--s-2) var(--s-3);
    border: var(--hairline) solid var(--fg);
    text-decoration: none;
    transition: background-color var(--dur-micro) var(--ease-hover), color var(--dur-micro) var(--ease-hover);
  }
  .closing__cta:active { transform: scale(0.98); }
  @media (hover: hover) and (pointer: fine) {
    .closing__cta:hover { background: var(--fg); color: var(--bg); }
  }

  .closing__contact {
    display: grid;
    gap: var(--s-1);
    margin-block-start: var(--s-6);
    padding-block-start: var(--s-3);
    border-block-start: var(--hairline) solid var(--rule);
    inline-size: 100%;
  }
  .closing__contact-title { font-size: var(--t-lg); line-height: var(--lh-tight); letter-spacing: var(--track-display); font-weight: 600; }
  .closing__contact-title a { color: var(--fg); }
  .closing__contact a {
    text-decoration-line: underline;
    text-decoration-thickness: var(--hairline);
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--dur-micro) var(--ease-hover);
  }
  @media (hover: hover) and (pointer: fine) {
    .closing__contact a:hover { text-decoration-color: var(--signal); }
  }
  .closing__routing { color: var(--fg-muted); line-height: var(--lh-text); }
  .closing__routing a { color: var(--fg); }
  .closing__identity { display: grid; margin-block-start: var(--s-2); font-size: var(--t-sm); color: var(--fg-muted); }

  @media (prefers-reduced-motion: reduce) {
    .closing__cta, .closing__contact a { transition: none; }
    .closing__cta:active { transform: none; }
  }
</style>
