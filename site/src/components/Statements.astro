---
/**
 * Home scene 2, "Datum" (structure-v1 §2.2): the four statements from copy deck §2.
 *
 * The datum is one Rhodamine hairline (light only) held at the middle of the viewport while the
 * statements scroll past. Each statement comes to rest ON the line, like words on a ruled sheet.
 * - It extends from the centre to both edges as the section arrives (scrubbed by scroll).
 * - Titles and bodies reveal by LINE (motion/reveal.ts via data-reveal), never by letter.
 * - The section ends with one quiet viewport where only the line remains. ProductIndex overlaps
 *   that beat, so the rail scene's canvas datum (progress 0) sits exactly under this line; the
 *   DOM line then fades out and the canvas line carries on and becomes the rail.
 * No JS / reduced motion: the line is simply there, full width; the words are static.
 * The statements are not numbered: they are not a sequence.
 */
import home from '../content/en/home.json';
---
<section class="statements">
  <div class="statements__datum" aria-hidden="true"><span class="statements__line"></span></div>
  <div class="frame">
    {home.statements.map((s) => (
      <article class="statement" id={`statement-${s.id}`}>
        <h2 class="statement__title" data-reveal="line">{s.title}</h2>
        <p class="statement__body" data-reveal="line">{s.body}</p>
      </article>
    ))}
  </div>
</section>

<script>
  /* Scroll-scrubbed datum: extend to both edges on arrival; fade at the handover. No three.js. */
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const section = document.querySelector<HTMLElement>('.statements');
  const line = section?.querySelector<HTMLElement>('.statements__line');
  const html = document.documentElement;
  const staged = (): boolean => html.classList.contains('js') && html.dataset.tier !== 'still' && html.dataset.tier !== 'none';
  if (section && line && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.registerPlugin(ScrollTrigger);
    // Arrival: the line grows from the centre to both edges while it rises to the middle.
    gsap.fromTo(
      line,
      { scaleX: 0 },
      { scaleX: 1, ease: 'none', scrollTrigger: { trigger: section, start: 'top bottom', end: 'top 50%', scrub: true } },
    );
    // Handover: only when the rail scene will pick the line up (a 3D tier). In the still tier the
    // line simply scrolls away with the section.
    if (staged()) {
      gsap.fromTo(
        line,
        { opacity: 1 },
        { opacity: 0, ease: 'none', scrollTrigger: { trigger: section, start: 'bottom bottom', end: 'bottom 60%', scrub: true } },
      );
    }
  }
</script>

<style>
  .statements { position: relative; }
  /* The datum: sticky at the middle of the viewport, full bleed (both edges, beyond the frame). */
  .statements__datum {
    position: sticky;
    inset-block-start: 50svh;
    block-size: var(--hairline);
    margin-block-end: calc(-1 * var(--hairline));
    z-index: 0;
    pointer-events: none;
  }
  .statements__line {
    display: block;
    block-size: 100%;
    background: var(--signal);
    transform-origin: 50% 50%; /* from the centre to both edges: symmetric for LTR and RTL */
  }
  /* Each statement is one viewport. Its words end just above the block's middle, so when the
     block is centred they sit on the datum. */
  .statement {
    position: relative;
    z-index: 1;
    min-block-size: 100svh;
    display: grid;
    align-content: end;
    gap: var(--s-2);
    padding-block: var(--s-8) calc(50svh + var(--s-2));
  }
  .statement__title {
    font-size: clamp(2rem, 1.1rem + 3.2vw, 4.25rem);
    line-height: var(--lh-tight);
    letter-spacing: var(--track-display);
    font-weight: 600;
    max-inline-size: 16ch;
    text-wrap: balance;
  }
  .statement__body {
    max-inline-size: var(--measure);
    font-size: var(--t-md);
    color: var(--fg-muted);
    text-wrap: pretty;
  }
  @media (min-width: 60rem) {
    .statement {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      column-gap: var(--s-6);
    }
  }
  /* The quiet beat: one viewport with only the line, overlapped by ProductIndex (3D tiers only). */
  :global(html.js:not([data-tier="still"]):not([data-tier="none"])) .statements { padding-block-end: 100svh; }
  @media (prefers-reduced-motion: reduce) {
    .statements__line { transform: none; }
  }
</style>
