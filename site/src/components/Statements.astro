---
import home from '../content/en/home.json';
// Four statements from copy deck §2. Not numbered: they are not a sequence.
---
<section class="statements">
  <div class="frame">
    {home.statements.map((s) => (
      <article class="statement" id={`statement-${s.id}`}>
        <h2 class="statement__title" data-reveal="line">{s.title}</h2>
        <p class="statement__body">{s.body}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .statement {
    display: grid;
    gap: var(--s-2);
    padding-block: var(--s-8);
    border-block-start: var(--hairline) solid var(--rule);
  }
  .statement__title {
    font-size: var(--t-lg);
    line-height: 1.15;
    letter-spacing: var(--track-display);
    font-weight: 600;
    max-inline-size: 22ch;
  }
  .statement__body { max-inline-size: var(--measure); color: var(--fg-muted); }
  @media (min-width: 60rem) {
    .statement { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: baseline; gap: var(--s-6); }
  }
</style>
