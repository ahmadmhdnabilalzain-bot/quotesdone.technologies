---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Statements from '../components/Statements.astro';
import ProductIndex from '../components/ProductIndex.astro';
import Closing from '../components/Closing.astro';
import QuotesDoneSection from '../components/home/QuotesDoneSection.astro';
import SonoboltSection from '../components/home/SonoboltSection.astro';
import MubinFlowSection from '../components/home/MubinFlowSection.astro';
import CompanySection from '../components/home/CompanySection.astro';
import home from '../content/en/home.json';
---
<Base title={home.meta.title} description={home.meta.description}>
  <Hero />
  <Statements />
  <ProductIndex />
  <QuotesDoneSection />
  <SonoboltSection />
  <MubinFlowSection />
  <CompanySection />
  <Closing />
