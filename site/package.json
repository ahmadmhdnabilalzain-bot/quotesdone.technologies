{
  "name": "quotesdone-technologies-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "QuotesDone Technologies hub website (Astro static + three.js). Milestone M0: foundation.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "decoders": "node scripts/copy-decoders.mjs",
    "predev": "npm run decoders",
    "dev": "astro dev",
    "prebuild": "npm run decoders",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "node scripts/check-content.mjs && node scripts/check-budgets.mjs",
    "lint": "astro check && node scripts/lint-source.mjs"
  },
  "dependencies": {
    "astro": "7.4.13",
    "gsap": "3.15.1",
    "lenis": "1.3.29",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.7",
    "@types/three": "0.187.0",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  }
}
